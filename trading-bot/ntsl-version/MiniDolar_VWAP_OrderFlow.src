{*******************************************************************************
  ROBÔ DE TRADING - MINI DÓLAR (WDO)

  Estratégia: VWAP + Order Flow
  Autor: Prof. Rodolfo Barriviera
  Versão: 1.1 NTSL (Corrigida para Automação)

  LÓGICA:
  - LONG: Preço próximo ao VWAP + Fluxo comprador + Book desequilibrado
  - SHORT: Preço próximo ao VWAP + Fluxo vendedor + Book desequilibrado
  - Saídas: Stop Loss, Take Profit ou reversão de fluxo

  IMPORTANTE: SEMPRE TESTE EM SIMULAÇÃO ANTES DE USAR EM CONTA REAL!
*******************************************************************************}

Var
  // ========== PARÂMETROS CONFIGURÁVEIS ==========
  // AJUSTE AQUI CONFORME SEU PERFIL DE RISCO

  // Parâmetros de Risco
  StopLossPoints     : Integer;      // Stop Loss em pontos
  TakeProfitPoints   : Integer;      // Take Profit em pontos
  MaxContracts       : Integer;      // Tamanho da posição (contratos)

  // Parâmetros da Estratégia - VWAP
  VWAPDeviationPct   : Float;        // Desvio % permitido do VWAP (0.05 = 0.05%)

  // Parâmetros de Fluxo de Ordens
  DeltaThreshold     : Float;        // Delta mínimo % para entrada (20 = 20%)
  BookImbalanceThreshold : Float;    // Desequilíbrio mínimo do book %
  FlowWindowSize     : Integer;      // Janela de análise de fluxo (ticks)

  // Configurações Gerais
  EnableLongTrades   : Boolean;      // Habilita trades LONG
  EnableShortTrades  : Boolean;      // Habilita trades SHORT
  EnableFlowExit     : Boolean;      // Sai na reversão de fluxo

  // Horários de Operação (formato HHMM)
  StartTime          : Integer;      // Hora de início
  EndTime            : Integer;      // Hora de encerramento
  StopNewTradesTime  : Integer;      // Hora de parar novas entradas

  // ========== VARIÁVEIS INTERNAS ==========

  // VWAP
  VWAPDaily          : Float;
  VWAPWeekly         : Float;
  DailyPV            : Float;
  DailyVolume        : Float;
  WeeklyPV           : Float;
  WeeklyVolume       : Float;

  // Controle de tempo
  LastDate           : Integer;
  LastWeek           : Integer;
  CurrentTime        : Integer;

  // Fluxo de Ordens
  BuyVolume          : Float;
  SellVolume         : Float;
  Delta              : Float;
  DeltaPct           : Float;
  BookImbalance      : Float;

  // Arrays para janela deslizante
  FlowVolumes        : Array[0..200] of Float;
  FlowAggressors     : Array[0..200] of Integer;
  FlowIndex          : Integer;

  // Controle de Posição
  InPosition         : Boolean;
  PositionType       : Integer;
  EntryPrice         : Float;
  StopPrice          : Float;
  TargetPrice        : Float;

  // Sinais
  LongSignal         : Boolean;
  ShortSignal        : Boolean;
  ExitSignal         : Boolean;

  // Book de Ofertas
  TotalBidVolume     : Float;
  TotalAskVolume     : Float;

  // Auxiliares
  PriceVsVWAP        : Float;
  IsInsideTime       : Boolean;
  CanEnterNew        : Boolean;

  // Contadores e loops
  TradesCount        : Integer;
  i                  : Integer;
  Initialized        : Boolean;

Begin

  // ========== INICIALIZAÇÃO (APENAS UMA VEZ) ==========

  If Not Initialized Then Begin
    // PERFIL MODERADO (PADRÃO)
    // Altere aqui para usar outro perfil
    StopLossPoints         := 50;
    TakeProfitPoints       := 100;
    MaxContracts           := 1;
    VWAPDeviationPct       := 0.05;
    DeltaThreshold         := 20;
    BookImbalanceThreshold := 15;
    FlowWindowSize         := 100;
    EnableLongTrades       := True;
    EnableShortTrades      := True;
    EnableFlowExit         := True;
    StartTime              := 900;
    EndTime                := 1730;
    StopNewTradesTime      := 1715;

    // ===== OUTROS PERFIS (DESCOMENTE O DESEJADO) =====

    // PERFIL CONSERVADOR
    {
    StopLossPoints         := 40;
    TakeProfitPoints       := 80;
    DeltaThreshold         := 25;
    BookImbalanceThreshold := 20;
    FlowWindowSize         := 150;
    }

    // PERFIL AGRESSIVO
    {
    StopLossPoints         := 70;
    TakeProfitPoints       := 140;
    MaxContracts           := 2;
    DeltaThreshold         := 15;
    BookImbalanceThreshold := 10;
    FlowWindowSize         := 75;
    }

    // PERFIL SCALPER
    {
    StopLossPoints         := 30;
    TakeProfitPoints       := 45;
    DeltaThreshold         := 15;
    BookImbalanceThreshold := 12;
    FlowWindowSize         := 50;
    StartTime              := 930;
    EndTime                := 1700;
    StopNewTradesTime      := 1630;
    }

    Initialized := True;
  End;


  // ========== CONTROLE DE TEMPO ==========

  // Reset diário do VWAP
  If Date <> LastDate Then Begin
    DailyPV := 0;
    DailyVolume := 0;
    LastDate := Date;
  End;

  // Reset semanal do VWAP (segunda-feira)
  If DayOfWeek = 1 Then Begin
    If LastWeek <> Date Then Begin
      WeeklyPV := 0;
      WeeklyVolume := 0;
      LastWeek := Date;
    End;
  End;

  // Verifica horário de operação
  CurrentTime := Time;
  IsInsideTime := (CurrentTime >= StartTime) And (CurrentTime <= EndTime);
  CanEnterNew := (CurrentTime >= StartTime) And (CurrentTime <= StopNewTradesTime);


  // ========== CÁLCULO DO VWAP ==========

  DailyPV := DailyPV + (Close * Volume);
  DailyVolume := DailyVolume + Volume;

  If DailyVolume > 0 Then
    VWAPDaily := DailyPV / DailyVolume
  Else
    VWAPDaily := Close;

  WeeklyPV := WeeklyPV + (Close * Volume);
  WeeklyVolume := WeeklyVolume + Volume;

  If WeeklyVolume > 0 Then
    VWAPWeekly := WeeklyPV / WeeklyVolume
  Else
    VWAPWeekly := Close;


  // ========== ANÁLISE DE FLUXO DE ORDENS ==========

  // Adiciona tick atual ao array
  FlowIndex := FlowIndex + 1;
  If FlowIndex > FlowWindowSize Then
    FlowIndex := 0;

  FlowVolumes[FlowIndex] := Volume;

  // Identifica agressor
  If Close >= Ask Then
    FlowAggressors[FlowIndex] := 1
  Else If Close <= Bid Then
    FlowAggressors[FlowIndex] := -1
  Else
    FlowAggressors[FlowIndex] := 0;

  // Calcula delta de volume
  BuyVolume := 0;
  SellVolume := 0;

  For i := 0 To FlowWindowSize Do Begin
    If FlowAggressors[i] = 1 Then
      BuyVolume := BuyVolume + FlowVolumes[i]
    Else If FlowAggressors[i] = -1 Then
      SellVolume := SellVolume + FlowVolumes[i];
  End;

  Delta := BuyVolume - SellVolume;

  If (BuyVolume + SellVolume) > 0 Then
    DeltaPct := (Delta / (BuyVolume + SellVolume)) * 100
  Else
    DeltaPct := 0;


  // ========== ANÁLISE DO BOOK ==========

  TotalBidVolume := BidVolume;
  TotalAskVolume := AskVolume;

  If (TotalBidVolume + TotalAskVolume) > 0 Then
    BookImbalance := ((TotalBidVolume - TotalAskVolume) / (TotalBidVolume + TotalAskVolume)) * 100
  Else
    BookImbalance := 0;


  // ========== SINAIS DE ENTRADA ==========

  If VWAPDaily > 0 Then
    PriceVsVWAP := ((Close - VWAPDaily) / VWAPDaily) * 100
  Else
    PriceVsVWAP := 0;

  LongSignal := False;
  ShortSignal := False;


  // SINAL LONG
  If EnableLongTrades And CanEnterNew And (Not InPosition) Then Begin
    If (PriceVsVWAP >= -VWAPDeviationPct) And (PriceVsVWAP <= VWAPDeviationPct) Then Begin
      If DeltaPct > DeltaThreshold Then Begin
        If BookImbalance > BookImbalanceThreshold Then Begin
          If (VWAPWeekly = 0) Or (Close >= VWAPWeekly * 0.98) Then Begin
            LongSignal := True;
          End;
        End;
      End;
    End;
  End;


  // SINAL SHORT
  If EnableShortTrades And CanEnterNew And (Not InPosition) Then Begin
    If (PriceVsVWAP >= -VWAPDeviationPct) And (PriceVsVWAP <= VWAPDeviationPct) Then Begin
      If DeltaPct < -DeltaThreshold Then Begin
        If BookImbalance < -BookImbalanceThreshold Then Begin
          If (VWAPWeekly = 0) Or (Close <= VWAPWeekly * 1.02) Then Begin
            ShortSignal := True;
          End;
        End;
      End;
    End;
  End;


  // ========== SAÍDAS ==========

  ExitSignal := False;

  If InPosition Then Begin

    If PositionType = 1 Then Begin  // Long
      If Close <= StopPrice Then
        ExitSignal := True;

      If Close >= TargetPrice Then
        ExitSignal := True;

      If EnableFlowExit And (DeltaPct < -DeltaThreshold) Then
        ExitSignal := True;
    End;

    If PositionType = -1 Then Begin  // Short
      If Close >= StopPrice Then
        ExitSignal := True;

      If Close <= TargetPrice Then
        ExitSignal := True;

      If EnableFlowExit And (DeltaPct > DeltaThreshold) Then
        ExitSignal := True;
    End;

    If CurrentTime >= EndTime Then
      ExitSignal := True;

  End;


  // ========== EXECUÇÃO DE ORDENS ==========

  // ENTRADA LONG
  If LongSignal Then Begin
    BuyToOpen(MaxContracts);
    InPosition := True;
    PositionType := 1;
    EntryPrice := Close;
    StopPrice := Close - StopLossPoints;
    TargetPrice := Close + TakeProfitPoints;
    TradesCount := TradesCount + 1;
  End;


  // ENTRADA SHORT
  If ShortSignal Then Begin
    SellToOpen(MaxContracts);
    InPosition := True;
    PositionType := -1;
    EntryPrice := Close;
    StopPrice := Close + StopLossPoints;
    TargetPrice := Close - TakeProfitPoints;
    TradesCount := TradesCount + 1;
  End;


  // SAÍDA
  If ExitSignal Then Begin
    If PositionType = 1 Then
      SellToCover(MaxContracts)
    Else If PositionType = -1 Then
      BuyToCover(MaxContracts);

    InPosition := False;
    PositionType := 0;
  End;


  // ========== PLOTAGEM ==========

  PlotNumeric('VWAP Diario', VWAPDaily, 0, clBlue, 2);
  PlotNumeric('VWAP Semanal', VWAPWeekly, 0, clGreen, 2);
  PlotNumeric('VWAP +0.5pct', VWAPDaily * 1.005, 0, clSilver, 1);
  PlotNumeric('VWAP -0.5pct', VWAPDaily * 0.995, 0, clSilver, 1);

  PlotNumeric('Delta pct', DeltaPct, 1, clYellow, 2);
  PlotNumeric('Book Imb', BookImbalance, 1, clOrange, 2);
  PlotNumeric('Delta+', DeltaThreshold, 1, clLime, 1);
  PlotNumeric('Delta-', -DeltaThreshold, 1, clRed, 1);

  If InPosition Then Begin
    If PositionType = 1 Then
      PlotNumeric('Posicao', 50, 2, clGreen, 4)
    Else
      PlotNumeric('Posicao', -50, 2, clRed, 4);
  End Else
    PlotNumeric('Posicao', 0, 2, clGray, 2);

End;

{*******************************************************************************
  INSTRUÇÕES DE USO:

  1. Copie TODO este código
  2. Abra o Profit Pro
  3. Vá em "Automação" > "Editor de Estratégias"
  4. Crie nova estratégia e cole este código
  5. Compile (F9) - deve compilar sem erros agora!
  6. Para mudar perfil: edite a seção INICIALIZAÇÃO (linha 105)
  7. TESTE EM SIMULAÇÃO primeiro!
  8. Aplique no gráfico do WDO

  PERFIS DISPONÍVEIS:
  - MODERADO (padrão ativo)
  - CONSERVADOR (descomente linhas 119-124)
  - AGRESSIVO (descomente linhas 127-134)
  - SCALPER (descomente linhas 137-145)

  IMPORTANTE:
  - Sempre teste em simulação antes de real
  - Monitore constantemente
  - Ajuste conforme necessário

*******************************************************************************}
