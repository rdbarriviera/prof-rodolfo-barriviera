{*******************************************************************************
  INDICADOR VWAP + ORDER FLOW - MINI DÓLAR
  Versão 2.2 - SINAIS SIMPLIFICADOS

  Autor: Prof. Rodolfo Barriviera

  ESTA VERSÃO É SIMPLIFICADA PARA MOSTRAR OS SINAIS CLARAMENTE!

  O que você verá:
  - Plot (azul): VWAP Diário
  - Plot2 (verde): VWAP Semanal
  - Plot3 (amarelo): Delta % (em painel separado)
  - Plot4 (branco): FORÇA DO SINAL
    * Positivo (+50 a +100) = Compra
    * Negativo (-50 a -100) = Venda
    * Perto de 0 = Sem sinal claro
*******************************************************************************}

Var
  // VWAP
  VWAPDaily          : Float;
  VWAPWeekly         : Float;
  DailyPV            : Float;
  DailyVolume        : Float;
  WeeklyPV           : Float;
  WeeklyVolume       : Float;

  // Controle de tempo
  LastDate           : Integer;
  LastWeek           : Integer;
  CurrentDay         : Integer;

  // Fluxo
  BuyVolume          : Float;
  SellVolume         : Float;
  Delta              : Float;
  DeltaPct           : Float;

  // Arrays
  FlowVolumes        : Array[0..100] of Float;
  FlowAggressors     : Array[0..100] of Integer;
  FlowIndex          : Integer;

  // Sinal
  SignalStrength     : Float;
  PriceVsVWAP        : Float;

  // Auxiliares
  PrevClose          : Float;
  i                  : Integer;

Begin

  // ========== RESET DIÁRIO/SEMANAL ==========

  If Date <> LastDate Then Begin
    DailyPV := 0;
    DailyVolume := 0;
    LastDate := Date;
  End;

  CurrentDay := DayOfWeek(Date);
  If CurrentDay = 2 Then Begin
    If LastWeek <> Date Then Begin
      WeeklyPV := 0;
      WeeklyVolume := 0;
      LastWeek := Date;
    End;
  End;


  // ========== CÁLCULO DO VWAP ==========

  DailyPV := DailyPV + (Close * Volume);
  DailyVolume := DailyVolume + Volume;

  If DailyVolume > 0 Then
    VWAPDaily := DailyPV / DailyVolume
  Else
    VWAPDaily := Close;

  WeeklyPV := WeeklyPV + (Close * Volume);
  WeeklyVolume := WeeklyVolume + Volume;

  If WeeklyVolume > 0 Then
    VWAPWeekly := WeeklyPV / WeeklyVolume
  Else
    VWAPWeekly := Close;


  // ========== ANÁLISE DE FLUXO (SIMPLIFICADO) ==========

  FlowIndex := FlowIndex + 1;
  If FlowIndex > 50 Then
    FlowIndex := 0;

  FlowVolumes[FlowIndex] := Volume;

  // Identifica direção
  If Close > PrevClose Then
    FlowAggressors[FlowIndex] := 1
  Else If Close < PrevClose Then
    FlowAggressors[FlowIndex] := -1
  Else
    FlowAggressors[FlowIndex] := 0;

  PrevClose := Close;

  // Calcula delta
  BuyVolume := 0;
  SellVolume := 0;

  For i := 0 To 50 Do Begin
    If FlowAggressors[i] = 1 Then
      BuyVolume := BuyVolume + FlowVolumes[i]
    Else If FlowAggressors[i] = -1 Then
      SellVolume := SellVolume + FlowVolumes[i];
  End;

  Delta := BuyVolume - SellVolume;

  If (BuyVolume + SellVolume) > 0 Then
    DeltaPct := (Delta / (BuyVolume + SellVolume)) * 100
  Else
    DeltaPct := 0;


  // ========== CÁLCULO DO SINAL ==========

  // Quanto o preço está longe do VWAP (em %)
  If VWAPDaily > 0 Then
    PriceVsVWAP := ((Close - VWAPDaily) / VWAPDaily) * 100
  Else
    PriceVsVWAP := 0;

  // FORÇA DO SINAL = Combinação de Delta e proximidade ao VWAP
  SignalStrength := 0;

  // Se Delta é positivo (compra) E preço próximo ao VWAP
  If DeltaPct > 0 Then Begin
    // Quanto maior o delta, mais forte o sinal
    // Quanto mais próximo do VWAP, mais forte o sinal
    If (PriceVsVWAP >= -0.2) And (PriceVsVWAP <= 0.2) Then
      SignalStrength := DeltaPct  // Sinal de COMPRA
    Else
      SignalStrength := DeltaPct / 2;  // Sinal fraco
  End;

  // Se Delta é negativo (venda) E preço próximo ao VWAP
  If DeltaPct < 0 Then Begin
    If (PriceVsVWAP >= -0.2) And (PriceVsVWAP <= 0.2) Then
      SignalStrength := DeltaPct  // Sinal de VENDA
    Else
      SignalStrength := DeltaPct / 2;  // Sinal fraco
  End;


  // ========== PLOTAGEM ==========

  // VWAP Diário (azul)
  Plot(VWAPDaily);

  // VWAP Semanal (verde)
  Plot2(VWAPWeekly);

  // Delta % (amarelo) - painel separado
  Plot3(DeltaPct);

  // Força do Sinal (branco) - painel separado
  // Positivo = Setup de COMPRA
  // Negativo = Setup de VENDA
  // Quanto maior (em módulo), mais forte o sinal
  Plot4(SignalStrength);

End;

{*******************************************************************************
  COMO INTERPRETAR O GRÁFICO:

  ============================================================================
  PAINÉIS
  ============================================================================

  PAINEL 1 (Preço):
  - Linha AZUL = VWAP Diário
  - Linha VERDE = VWAP Semanal
  - Barras = Preço do WDO

  PAINEL 2 (Delta %):
  - Linha AMARELA = Delta de Volume
    * Positivo (+) = Mais compras que vendas
    * Negativo (-) = Mais vendas que compras
    * Quanto maior (em módulo), mais forte o fluxo

  PAINEL 3 (Força do Sinal):
  - Linha BRANCA = Força do Setup
    * Positivo (+) = Setup de COMPRA
    * Negativo (-) = Setup de VENDA
    * Quanto maior (em módulo), melhor o setup


  ============================================================================
  COMO OPERAR
  ============================================================================

  SETUP DE COMPRA:
  1. Observe PAINEL 3 (Força do Sinal) ficar POSITIVO (>10)
  2. Confirme que PAINEL 2 (Delta) está POSITIVO
  3. Confirme que Preço está PRÓXIMO ao VWAP Azul
  4. COMPRE 1 contrato
  5. Stop: -50 pontos
  6. Target: +100 pontos

  SETUP DE VENDA:
  1. Observe PAINEL 3 (Força do Sinal) ficar NEGATIVO (<-10)
  2. Confirme que PAINEL 2 (Delta) está NEGATIVO
  3. Confirme que Preço está PRÓXIMO ao VWAP Azul
  4. VENDA 1 contrato
  5. Stop: +50 pontos
  6. Target: -100 pontos


  ============================================================================
  INTERPRETAÇÃO DETALHADA
  ============================================================================

  PAINEL 3 (Força do Sinal) - O MAIS IMPORTANTE:

  Valor entre +50 a +100:
  → Setup FORTE de COMPRA
  → Delta muito positivo
  → Preço no VWAP
  → CONSIDERE COMPRAR

  Valor entre +10 a +50:
  → Setup MODERADO de COMPRA
  → Delta positivo
  → Preço próximo ao VWAP
  → PODE COMPRAR

  Valor entre -10 a +10:
  → SEM SINAL CLARO
  → Aguarde

  Valor entre -10 a -50:
  → Setup MODERADO de VENDA
  → Delta negativo
  → Preço próximo ao VWAP
  → PODE VENDER

  Valor entre -50 a -100:
  → Setup FORTE de VENDA
  → Delta muito negativo
  → Preço no VWAP
  → CONSIDERE VENDER


  ============================================================================
  EXEMPLO PRÁTICO
  ============================================================================

  Situação às 14:30h:

  PAINEL 1: Preço = 5650 | VWAP Azul = 5648
  PAINEL 2: Delta = +25%
  PAINEL 3: Força = +20

  Interpretação:
  ✓ Preço está próximo ao VWAP (5650 vs 5648)
  ✓ Delta positivo (+25%) = Fluxo comprador
  ✓ Força do Sinal = +20 = Setup MODERADO de compra

  Ação: COMPRA 1 contrato a 5650
  Stop: 5600 (-50)
  Target: 5750 (+100)


  ============================================================================
  AJUSTES
  ============================================================================

  Este indicador NÃO tem parâmetros editáveis para manter simples.

  Se quiser ajustar:
  - Linha 129: Mude 0.2 para outro valor (proximidade ao VWAP)
    * 0.1 = Mais restrito (apenas muito perto do VWAP)
    * 0.5 = Mais permissivo (aceita preços mais longe)

  - Linha 97: Mude 50 para outro valor (janela de fluxo)
    * 30 = Mais rápido, mais sinais
    * 100 = Mais lento, sinais mais estáveis


  ============================================================================
  CHECKLIST
  ============================================================================

  [ ] Vejo 3 painéis no gráfico
  [ ] PAINEL 1 tem linhas azul e verde (VWAPs)
  [ ] PAINEL 2 tem linha amarela oscilando (Delta)
  [ ] PAINEL 3 tem linha branca oscilando (Força do Sinal)
  [ ] Entendi que positivo = compra, negativo = venda
  [ ] Vou operar apenas quando Força > 10 ou < -10
  [ ] Vou usar stop loss SEMPRE
  [ ] Vou testar em simulação primeiro


  ============================================================================
  IMPORTANTE
  ============================================================================

  - Este é um INDICADOR, não robô automático
  - VOCÊ decide quando operar
  - SEMPRE use stop loss
  - Teste em simulação primeiro
  - Trading tem risco de perda
  - Opere apenas com capital que pode perder

*******************************************************************************}
