{*******************************************************************************
  INDICADOR - VWAP + ORDER FLOW - MINI DÓLAR

  Estratégia: VWAP + Análise de Fluxo
  Autor: Prof. Rodolfo Barriviera
  Versão: 2.0 NTSL - INDICADOR VISUAL

  ESTE É UM INDICADOR, NÃO UM ROBÔ AUTOMÁTICO!

  O que este código faz:
  - Mostra VWAP diário e semanal no gráfico
  - Calcula e mostra Delta de volume (fluxo)
  - Indica visualmente quando há setup de entrada
  - VOCÊ opera manualmente baseado nos sinais

  Como usar:
  1. Compile e aplique no gráfico WDO
  2. Observe os plots no gráfico
  3. Quando Plot4 (sinal) ficar > 50 = COMPRA
  4. Quando Plot4 (sinal) ficar < -50 = VENDA
  5. Use stop de 50 pontos e target de 100 pontos

  SEMPRE TESTE EM SIMULAÇÃO!
*******************************************************************************}

Var
  // Parâmetros
  StopLossPoints     : Integer;
  TakeProfitPoints   : Integer;
  VWAPDeviationPct   : Float;
  DeltaThreshold     : Float;
  FlowWindowSize     : Integer;

  // VWAP
  VWAPDaily          : Float;
  VWAPWeekly         : Float;
  DailyPV            : Float;
  DailyVolume        : Float;
  WeeklyPV           : Float;
  WeeklyVolume       : Float;

  // Controle de tempo
  LastDate           : Integer;
  LastWeek           : Integer;
  CurrentDay         : Integer;

  // Fluxo
  BuyVolume          : Float;
  SellVolume         : Float;
  Delta              : Float;
  DeltaPct           : Float;

  // Arrays
  FlowVolumes        : Array[0..200] of Float;
  FlowAggressors     : Array[0..200] of Integer;
  FlowIndex          : Integer;

  // Sinais
  LongSetup          : Boolean;
  ShortSetup         : Boolean;
  SignalValue        : Float;

  // Auxiliares
  PriceVsVWAP        : Float;
  PrevClose          : Float;
  i                  : Integer;
  Initialized        : Boolean;

Begin

  // ========== INICIALIZAÇÃO ==========

  If Not Initialized Then Begin
    // PERFIL MODERADO (PADRÃO)
    StopLossPoints    := 50;
    TakeProfitPoints  := 100;
    VWAPDeviationPct  := 0.05;
    DeltaThreshold    := 20;
    FlowWindowSize    := 100;

    // CONSERVADOR (descomente para usar)
    {
    StopLossPoints    := 40;
    TakeProfitPoints  := 80;
    DeltaThreshold    := 25;
    FlowWindowSize    := 150;
    }

    // AGRESSIVO (descomente para usar)
    {
    StopLossPoints    := 70;
    TakeProfitPoints  := 140;
    DeltaThreshold    := 15;
    FlowWindowSize    := 75;
    }

    Initialized := True;
  End;


  // ========== RESET DIÁRIO/SEMANAL ==========

  If Date <> LastDate Then Begin
    DailyPV := 0;
    DailyVolume := 0;
    LastDate := Date;
  End;

  CurrentDay := DayOfWeek(Date);
  If CurrentDay = 2 Then Begin
    If LastWeek <> Date Then Begin
      WeeklyPV := 0;
      WeeklyVolume := 0;
      LastWeek := Date;
    End;
  End;


  // ========== CÁLCULO DO VWAP ==========

  DailyPV := DailyPV + (Close * Volume);
  DailyVolume := DailyVolume + Volume;

  If DailyVolume > 0 Then
    VWAPDaily := DailyPV / DailyVolume
  Else
    VWAPDaily := Close;

  WeeklyPV := WeeklyPV + (Close * Volume);
  WeeklyVolume := WeeklyVolume + Volume;

  If WeeklyVolume > 0 Then
    VWAPWeekly := WeeklyPV / WeeklyVolume
  Else
    VWAPWeekly := Close;


  // ========== ANÁLISE DE FLUXO ==========

  FlowIndex := FlowIndex + 1;
  If FlowIndex > FlowWindowSize Then
    FlowIndex := 0;

  FlowVolumes[FlowIndex] := Volume;

  If Close > PrevClose Then
    FlowAggressors[FlowIndex] := 1
  Else If Close < PrevClose Then
    FlowAggressors[FlowIndex] := -1
  Else
    FlowAggressors[FlowIndex] := 0;

  PrevClose := Close;

  BuyVolume := 0;
  SellVolume := 0;

  For i := 0 To FlowWindowSize Do Begin
    If FlowAggressors[i] = 1 Then
      BuyVolume := BuyVolume + FlowVolumes[i]
    Else If FlowAggressors[i] = -1 Then
      SellVolume := SellVolume + FlowVolumes[i];
  End;

  Delta := BuyVolume - SellVolume;

  If (BuyVolume + SellVolume) > 0 Then
    DeltaPct := (Delta / (BuyVolume + SellVolume)) * 100
  Else
    DeltaPct := 0;


  // ========== IDENTIFICAÇÃO DE SETUPS ==========

  If VWAPDaily > 0 Then
    PriceVsVWAP := ((Close - VWAPDaily) / VWAPDaily) * 100
  Else
    PriceVsVWAP := 0;

  LongSetup := False;
  ShortSetup := False;


  // SETUP DE COMPRA
  If (PriceVsVWAP >= -VWAPDeviationPct) And (PriceVsVWAP <= VWAPDeviationPct) Then Begin
    If DeltaPct > DeltaThreshold Then Begin
      If (VWAPWeekly = 0) Or (Close >= VWAPWeekly * 0.98) Then Begin
        LongSetup := True;
      End;
    End;
  End;


  // SETUP DE VENDA
  If (PriceVsVWAP >= -VWAPDeviationPct) And (PriceVsVWAP <= VWAPDeviationPct) Then Begin
    If DeltaPct < -DeltaThreshold Then Begin
      If (VWAPWeekly = 0) Or (Close <= VWAPWeekly * 1.02) Then Begin
        ShortSetup := True;
      End;
    End;
  End;


  // ========== GERAÇÃO DO SINAL VISUAL ==========

  SignalValue := 0;

  If LongSetup Then
    SignalValue := 100;     // Sinal positivo = COMPRA

  If ShortSetup Then
    SignalValue := -100;    // Sinal negativo = VENDA


  // ========== PLOTAGEM NO GRÁFICO ==========

  // Plot principal: VWAP Diário (azul)
  Plot(VWAPDaily);

  // Plot2: VWAP Semanal (verde)
  Plot2(VWAPWeekly);

  // Plot3: Delta % (amarelo) - em painel separado
  Plot3(DeltaPct);

  // Plot4: Sinal de entrada (branco)
  // Quando = 100: COMPRA
  // Quando = -100: VENDA
  // Quando = 0: Sem sinal
  Plot4(SignalValue);

End;

{*******************************************************************************
  MANUAL DE USO - LEIA COM ATENÇÃO!

  ============================================================================
  1. INSTALAÇÃO
  ============================================================================

  - Abra o Profit Pro
  - Vá em "Gráficos" > "Inserir Indicador"
  - Cole este código
  - Compile (F9)
  - Aplique no gráfico do WDO (mini dólar)
  - Timeframe recomendado: 1 minuto


  ============================================================================
  2. O QUE VOCÊ VAI VER NO GRÁFICO
  ============================================================================

  PAINEL PRINCIPAL (Preço):
  - Plot (AZUL): VWAP Diário
  - Plot2 (VERDE): VWAP Semanal

  PAINEL INFERIOR 1:
  - Plot3 (AMARELO): Delta % (fluxo comprador/vendedor)
    * Positivo = Mais compra
    * Negativo = Mais venda

  PAINEL INFERIOR 2:
  - Plot4 (BRANCO): Sinal de entrada
    * +100 = SINAL DE COMPRA
    * -100 = SINAL DE VENDA
    * 0 = Sem sinal


  ============================================================================
  3. COMO OPERAR
  ============================================================================

  SINAL DE COMPRA (Plot4 = 100):
  1. Observe Plot4 (sinal) saltar para +100
  2. Verifique que preço está próximo ao VWAP azul
  3. Verifique que Delta (amarelo) está positivo
  4. COMPRE 1 contrato a mercado
  5. Coloque STOP em: Preço de entrada - 50 pontos
  6. Coloque TARGET em: Preço de entrada + 100 pontos

  SINAL DE VENDA (Plot4 = -100):
  1. Observe Plot4 (sinal) saltar para -100
  2. Verifique que preço está próximo ao VWAP azul
  3. Verifique que Delta (amarelo) está negativo
  4. VENDA 1 contrato a mercado
  5. Coloque STOP em: Preço de entrada + 50 pontos
  6. Coloque TARGET em: Preço de entrada - 100 pontos


  ============================================================================
  4. REGRAS DE GESTÃO DE RISCO
  ============================================================================

  - Opere APENAS 1 contrato por vez
  - SEMPRE use stop loss (50 pontos)
  - SEMPRE use take profit (100 pontos)
  - Não opere fora do horário 9h-17:15h
  - Máximo 5 trades por dia
  - Se tomar 3 stops seguidos, pare de operar no dia


  ============================================================================
  5. PERFIS DE RISCO
  ============================================================================

  MODERADO (ATIVO - linhas 71-75):
  - Stop: 50 pontos
  - Target: 100 pontos
  - Delta threshold: 20%

  CONSERVADOR (descomente linhas 78-83):
  - Stop: 40 pontos
  - Target: 80 pontos
  - Delta threshold: 25%

  AGRESSIVO (descomente linhas 86-91):
  - Stop: 70 pontos
  - Target: 140 pontos
  - Delta threshold: 15%


  ============================================================================
  6. INTERPRETAÇÃO DOS INDICADORES
  ============================================================================

  VWAP DIÁRIO (Azul):
  - Referência de valor justo do dia
  - Operações próximas ao VWAP têm maior probabilidade

  VWAP SEMANAL (Verde):
  - Indica tendência da semana
  - Evite comprar muito abaixo ou vender muito acima

  DELTA % (Amarelo):
  - Mostra força compradora/vendedora
  - > +20% = Fluxo comprador forte
  - < -20% = Fluxo vendedor forte

  SINAL (Branco):
  - Pisca em +100 = Setup de compra identificado
  - Pisca em -100 = Setup de venda identificado
  - Fica em 0 = Aguardando condições


  ============================================================================
  7. CHECKLIST ANTES DE OPERAR
  ============================================================================

  [ ] Testei em simulação por pelo menos 2 semanas
  [ ] Entendi como funciona o VWAP
  [ ] Entendi como funciona o Delta
  [ ] Sei interpretar os sinais
  [ ] Tenho capital suficiente para suportar perdas
  [ ] Configurei stop loss e take profit
  [ ] Estou operando apenas 1 contrato
  [ ] Vou monitorar constantemente


  ============================================================================
  8. AVISOS IMPORTANTES
  ============================================================================

  ⚠️ Este é um INDICADOR, não um robô automático
  ⚠️ VOCÊ precisa executar as ordens manualmente
  ⚠️ SEMPRE teste em simulação primeiro
  ⚠️ Trading envolve risco de perda
  ⚠️ Não opere com dinheiro que não pode perder
  ⚠️ Monitore constantemente suas posições
  ⚠️ Use stop loss SEMPRE


  ============================================================================
  9. EXEMPLO PRÁTICO
  ============================================================================

  Situação: Plot4 salta para +100 às 10:30h

  Verificações:
  ✓ Preço (5650) está próximo ao VWAP diário (5648)
  ✓ Delta está em +25% (fluxo comprador)
  ✓ VWAP semanal está em 5640 (preço acima - ok)

  Ação:
  1. COMPRA 1 contrato de WDOH25 a 5650
  2. Stop Loss em 5600 (5650 - 50)
  3. Take Profit em 5750 (5650 + 100)

  Resultado possível:
  - Acertou: +100 pontos = R$ 40 de lucro
  - Errou: -50 pontos = R$ 20 de prejuízo
  - Relação risco/retorno: 1:2


  ============================================================================
  10. SUPORTE E AJUDA
  ============================================================================

  Se tiver dúvidas:
  - Revise este manual
  - Teste mais em simulação
  - Ajuste os parâmetros gradualmente
  - Anote seus resultados para aprender


  Bons trades e boa sorte!
  Lembre-se: Disciplina > Estratégia

*******************************************************************************}
