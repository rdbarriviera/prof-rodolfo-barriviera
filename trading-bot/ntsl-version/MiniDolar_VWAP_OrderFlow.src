{*******************************************************************************
  INDICADOR VWAP + ORDER FLOW - MINI DÓLAR
  Versão 2.3 - TUDO NO MESMO PAINEL

  Autor: Prof. Rodolfo Barriviera

  ESTA VERSÃO MOSTRA TUDO NO MESMO PAINEL DO PREÇO!

  O que você verá (TODAS AS LINHAS NO GRÁFICO DE PREÇO):
  - Plot (AZUL GROSSO): VWAP Diário
  - Plot2 (VERDE GROSSO): VWAP Semanal
  - Plot3 (AMARELO): Bandas do VWAP (+0.2%)
  - Plot4 (VERMELHO): Bandas do VWAP (-0.2%)

  SINAIS:
  - Quando preço CRUZA o VWAP azul com Delta positivo = COMPRA
  - Quando preço CRUZA o VWAP azul com Delta negativo = VENDA

  OBS: Delta será mostrado nos valores do indicador (canto do gráfico)
*******************************************************************************}

Var
  // VWAP
  VWAPDaily          : Float;
  VWAPWeekly         : Float;
  DailyPV            : Float;
  DailyVolume        : Float;
  WeeklyPV           : Float;
  WeeklyVolume       : Float;

  // Controle de tempo
  LastDate           : Integer;
  LastWeek           : Integer;
  CurrentDay         : Integer;

  // Fluxo
  BuyVolume          : Float;
  SellVolume         : Float;
  Delta              : Float;
  DeltaPct           : Float;

  // Arrays
  FlowVolumes        : Array[0..100] of Float;
  FlowAggressors     : Array[0..100] of Integer;
  FlowIndex          : Integer;

  // Bandas
  UpperBand          : Float;
  LowerBand          : Float;

  // Auxiliares
  PrevClose          : Float;
  i                  : Integer;

Begin

  // ========== RESET DIÁRIO ==========

  If Date <> LastDate Then Begin
    DailyPV := 0;
    DailyVolume := 0;
    LastDate := Date;
  End;

  CurrentDay := DayOfWeek(Date);
  If CurrentDay = 2 Then Begin
    If LastWeek <> Date Then Begin
      WeeklyPV := 0;
      WeeklyVolume := 0;
      LastWeek := Date;
    End;
  End;


  // ========== CÁLCULO DO VWAP ==========

  DailyPV := DailyPV + (Close * Volume);
  DailyVolume := DailyVolume + Volume;

  If DailyVolume > 0 Then
    VWAPDaily := DailyPV / DailyVolume
  Else
    VWAPDaily := Close;

  WeeklyPV := WeeklyPV + (Close * Volume);
  WeeklyVolume := WeeklyVolume + Volume;

  If WeeklyVolume > 0 Then
    VWAPWeekly := WeeklyPV / WeeklyVolume
  Else
    VWAPWeekly := Close;


  // ========== CÁLCULO DAS BANDAS ==========

  // Bandas de ±0.2% do VWAP diário
  UpperBand := VWAPDaily * 1.002;  // +0.2%
  LowerBand := VWAPDaily * 0.998;  // -0.2%


  // ========== ANÁLISE DE FLUXO ==========

  FlowIndex := FlowIndex + 1;
  If FlowIndex > 50 Then
    FlowIndex := 0;

  FlowVolumes[FlowIndex] := Volume;

  If Close > PrevClose Then
    FlowAggressors[FlowIndex] := 1
  Else If Close < PrevClose Then
    FlowAggressors[FlowIndex] := -1
  Else
    FlowAggressors[FlowIndex] := 0;

  PrevClose := Close;

  BuyVolume := 0;
  SellVolume := 0;

  For i := 0 To 50 Do Begin
    If FlowAggressors[i] = 1 Then
      BuyVolume := BuyVolume + FlowVolumes[i]
    Else If FlowAggressors[i] = -1 Then
      SellVolume := SellVolume + FlowVolumes[i];
  End;

  Delta := BuyVolume - SellVolume;

  If (BuyVolume + SellVolume) > 0 Then
    DeltaPct := (Delta / (BuyVolume + SellVolume)) * 100
  Else
    DeltaPct := 0;


  // ========== PLOTAGEM (TUDO NO MESMO PAINEL) ==========

  // VWAP Diário (linha AZUL GROSSA)
  Plot(VWAPDaily);

  // VWAP Semanal (linha VERDE GROSSA)
  Plot2(VWAPWeekly);

  // Banda Superior (linha AMARELA FINA)
  Plot3(UpperBand);

  // Banda Inferior (linha VERMELHA FINA)
  Plot4(LowerBand);

  // O Delta % pode ser visto no canto do gráfico nos "Valores do Indicador"
  // Ou você pode descomentar a linha abaixo para plotá-lo (mas ficará difícil de ver)
  // Plot5(DeltaPct);

End;

{*******************************************************************************
  COMO USAR ESTE INDICADOR ULTRA-SIMPLIFICADO:

  ============================================================================
  O QUE VOCÊ VERÁ NO GRÁFICO
  ============================================================================

  4 LINHAS NO PAINEL DE PREÇO (todas juntas):

  1. LINHA AZUL (grossa) = VWAP Diário
     → Referência principal
     → Preço "justo" do dia

  2. LINHA VERDE (grossa) = VWAP Semanal
     → Tendência da semana
     → Contexto maior

  3. LINHA AMARELA (fina) = Banda Superior
     → +0.2% acima do VWAP
     → Limite superior da zona de operação

  4. LINHA VERMELHA (fina) = Banda Inferior
     → -0.2% abaixo do VWAP
     → Limite inferior da zona de operação


  ============================================================================
  COMO OPERAR (MUITO SIMPLES)
  ============================================================================

  REGRA BÁSICA:
  → Opere quando o PREÇO estiver DENTRO das bandas (entre amarelo e vermelho)
  → Olhe para o CANTO DO GRÁFICO para ver o Delta %

  SETUP DE COMPRA:
  1. Preço está DENTRO das bandas (entre amarelo e vermelho)
  2. Preço TOCOU ou CRUZOU o VWAP Azul
  3. Olhe no canto: Delta % está POSITIVO (+10 ou mais)
  4. COMPRE 1 contrato
  5. Stop: -50 pontos
  6. Target: +100 pontos

  SETUP DE VENDA:
  1. Preço está DENTRO das bandas (entre amarelo e vermelho)
  2. Preço TOCOU ou CRUZOU o VWAP Azul
  3. Olhe no canto: Delta % está NEGATIVO (-10 ou menos)
  4. VENDA 1 contrato
  5. Stop: +50 pontos
  6. Target: -100 pontos


  ============================================================================
  ONDE VER O DELTA %
  ============================================================================

  O Delta % NÃO é plotado no gráfico para não poluir.

  Para ver o Delta %:
  - Olhe no CANTO SUPERIOR ou INFERIOR do gráfico
  - Procure por "Valores do Indicador" ou "Indicator Values"
  - Lá aparecerá o valor do Delta em tempo real

  Ou se preferir ver no gráfico:
  - Descomente a linha 144 (remova o //)
  - O Delta aparecerá mas pode ficar confuso


  ============================================================================
  INTERPRETAÇÃO VISUAL
  ============================================================================

  CENÁRIO 1 - Preço entre as bandas, tocando VWAP azul, Delta +15%:
  → COMPRA! Setup perfeito de compra

  CENÁRIO 2 - Preço entre as bandas, tocando VWAP azul, Delta -20%:
  → VENDA! Setup perfeito de venda

  CENÁRIO 3 - Preço FORA das bandas:
  → NÃO OPERE! Preço muito longe do VWAP

  CENÁRIO 4 - Preço nas bandas mas Delta próximo de 0:
  → AGUARDE! Sem sinal de fluxo claro


  ============================================================================
  CORES DAS LINHAS (Configure se precisar)
  ============================================================================

  Se as cores não estiverem certas:
  1. Clique com botão direito no indicador
  2. Propriedades > Cores
  3. Configure:
     - Plot = AZUL (espessura 3)
     - Plot2 = VERDE (espessura 3)
     - Plot3 = AMARELO (espessura 1)
     - Plot4 = VERMELHO (espessura 1)


  ============================================================================
  EXEMPLO PRÁTICO
  ============================================================================

  Situação às 10:45h:

  Observo o gráfico:
  - Preço: 5650
  - VWAP Azul: 5648
  - Banda Amarela: 5659
  - Banda Vermelha: 5637
  - Delta (no canto): +22%

  Análise:
  ✓ Preço (5650) está ENTRE as bandas (5637 a 5659)
  ✓ Preço está MUITO PRÓXIMO ao VWAP azul (5648)
  ✓ Delta é POSITIVO (+22%)

  Ação: COMPRA 1 contrato a 5650
  Stop: 5600
  Target: 5750


  ============================================================================
  DICAS
  ============================================================================

  1. As bandas (amarelo/vermelho) criam uma "zona de operação"
  2. Opere APENAS quando o preço está nessa zona
  3. O VWAP azul é sua principal referência
  4. O Delta % (no canto) te diz se é compra ou venda
  5. SIMPLES assim!


  ============================================================================
  VANTAGENS DESTA VERSÃO
  ============================================================================

  ✓ TUDO NO MESMO PAINEL - Fácil de ver
  ✓ SEM CONFUSÃO - Apenas 4 linhas claras
  ✓ VISUAL LIMPO - Não polui o gráfico
  ✓ FÁCIL DE ENTENDER - Lógica óbvia


  ============================================================================
  IMPORTANTE
  ============================================================================

  - Este é um INDICADOR simples de VWAP + Bandas
  - O Delta % é mostrado nos valores (canto do gráfico)
  - VOCÊ decide quando operar manualmente
  - SEMPRE use stop loss
  - Teste em simulação primeiro
  - Trading tem risco de perda

*******************************************************************************}
