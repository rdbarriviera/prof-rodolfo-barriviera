{*******************************************************************************
  INDICADOR - VWAP + ORDER FLOW - MINI DÓLAR

  Versão: 2.1 - MELHORADA COM SINAIS VISUAIS
  Autor: Prof. Rodolfo Barriviera

  MELHORIAS DESTA VERSÃO:
  - Sinais mais visíveis no gráfico
  - Condições de entrada mais realistas
  - Plots em painéis separados
  - Valores de debug para verificar funcionamento

  O QUE VOCÊ VERÁ:
  - Linha AZUL: VWAP Diário (painel principal)
  - Linha VERDE: VWAP Semanal (painel principal)
  - Painel inferior: Delta % (fluxo)
  - SETAS: Compra (verde) e Venda (vermelha)
*******************************************************************************}

Var
  // Parâmetros
  VWAPDeviationPct   : Float;
  DeltaThreshold     : Float;
  FlowWindowSize     : Integer;

  // VWAP
  VWAPDaily          : Float;
  VWAPWeekly         : Float;
  DailyPV            : Float;
  DailyVolume        : Float;
  WeeklyPV           : Float;
  WeeklyVolume       : Float;

  // Controle de tempo
  LastDate           : Integer;
  LastWeek           : Integer;
  CurrentDay         : Integer;

  // Fluxo
  BuyVolume          : Float;
  SellVolume         : Float;
  Delta              : Float;
  DeltaPct           : Float;

  // Arrays
  FlowVolumes        : Array[0..200] of Float;
  FlowAggressors     : Array[0..200] of Integer;
  FlowIndex          : Integer;

  // Sinais
  LongSignal         : Boolean;
  ShortSignal        : Boolean;

  // Auxiliares
  PriceVsVWAP        : Float;
  PrevClose          : Float;
  i                  : Integer;
  Initialized        : Boolean;

Begin

  // ========== INICIALIZAÇÃO ==========

  If Not Initialized Then Begin
    VWAPDeviationPct  := 0.1;   // 0.1% = mais tolerante
    DeltaThreshold    := 10;     // 10% = mais fácil de atingir
    FlowWindowSize    := 50;     // Janela menor = reage mais rápido
    Initialized       := True;
  End;


  // ========== RESET DIÁRIO/SEMANAL ==========

  If Date <> LastDate Then Begin
    DailyPV := 0;
    DailyVolume := 0;
    LastDate := Date;
  End;

  CurrentDay := DayOfWeek(Date);
  If CurrentDay = 2 Then Begin
    If LastWeek <> Date Then Begin
      WeeklyPV := 0;
      WeeklyVolume := 0;
      LastWeek := Date;
    End;
  End;


  // ========== CÁLCULO DO VWAP ==========

  DailyPV := DailyPV + (Close * Volume);
  DailyVolume := DailyVolume + Volume;

  If DailyVolume > 0 Then
    VWAPDaily := DailyPV / DailyVolume
  Else
    VWAPDaily := Close;

  WeeklyPV := WeeklyPV + (Close * Volume);
  WeeklyVolume := WeeklyVolume + Volume;

  If WeeklyVolume > 0 Then
    VWAPWeekly := WeeklyPV / WeeklyVolume
  Else
    VWAPWeekly := Close;


  // ========== ANÁLISE DE FLUXO ==========

  FlowIndex := FlowIndex + 1;
  If FlowIndex > FlowWindowSize Then
    FlowIndex := 0;

  FlowVolumes[FlowIndex] := Volume;

  // Identifica direção do tick
  If Close > PrevClose Then
    FlowAggressors[FlowIndex] := 1
  Else If Close < PrevClose Then
    FlowAggressors[FlowIndex] := -1
  Else
    FlowAggressors[FlowIndex] := 0;

  PrevClose := Close;

  // Calcula delta
  BuyVolume := 0;
  SellVolume := 0;

  For i := 0 To FlowWindowSize Do Begin
    If FlowAggressors[i] = 1 Then
      BuyVolume := BuyVolume + FlowVolumes[i]
    Else If FlowAggressors[i] = -1 Then
      SellVolume := SellVolume + FlowVolumes[i];
  End;

  Delta := BuyVolume - SellVolume;

  If (BuyVolume + SellVolume) > 0 Then
    DeltaPct := (Delta / (BuyVolume + SellVolume)) * 100
  Else
    DeltaPct := 0;


  // ========== GERAÇÃO DE SINAIS ==========

  If VWAPDaily > 0 Then
    PriceVsVWAP := ((Close - VWAPDaily) / VWAPDaily) * 100
  Else
    PriceVsVWAP := 0;

  LongSignal := False;
  ShortSignal := False;


  // SINAL DE COMPRA
  // Preço próximo ao VWAP E Delta positivo
  If (PriceVsVWAP >= -VWAPDeviationPct) And (PriceVsVWAP <= VWAPDeviationPct) Then Begin
    If DeltaPct > DeltaThreshold Then Begin
      LongSignal := True;
    End;
  End;


  // SINAL DE VENDA
  // Preço próximo ao VWAP E Delta negativo
  If (PriceVsVWAP >= -VWAPDeviationPct) And (PriceVsVWAP <= VWAPDeviationPct) Then Begin
    If DeltaPct < -DeltaThreshold Then Begin
      ShortSignal := True;
    End;
  End;


  // ========== PLOTAGEM ==========

  // VWAP Diário (linha azul no painel principal)
  Plot(VWAPDaily);

  // VWAP Semanal (linha verde no painel principal)
  Plot2(VWAPWeekly);

  // Delta % (linha amarela em painel separado)
  Plot3(DeltaPct);

  // Sinais visuais usando Plot4
  // Quando há sinal de compra, plota no Low (abaixo da barra)
  // Quando há sinal de venda, plota no High (acima da barra)
  If LongSignal Then
    Plot4(Low - 10)
  Else If ShortSignal Then
    Plot4(High + 10)
  Else
    Plot4(0);  // Sem sinal

End;

{*******************************************************************************
  COMO USAR ESTE INDICADOR:

  1. INSTALAÇÃO:
     - Profit Pro > Gráficos > Inserir Indicador
     - Cole este código
     - Compile (F9)
     - Aplique no gráfico WDO (mini dólar)
     - Timeframe: 1 minuto ou tick

  2. O QUE APARECE:
     No painel principal (preço):
     - Linha AZUL = VWAP Diário (referência)
     - Linha VERDE = VWAP Semanal (tendência)
     - Plot4 (pontos) = Sinais de entrada

     No painel inferior:
     - Linha AMARELA = Delta % (fluxo)
       Positivo = Compra
       Negativo = Venda

  3. SINAIS:
     - Quando aparecer PONTO ABAIXO da barra (Plot4) = COMPRA
       → Delta está positivo (+10% ou mais)
       → Preço está próximo ao VWAP
       → Execute: Compra 1 contrato
       → Stop: -50 pontos
       → Target: +100 pontos

     - Quando aparecer PONTO ACIMA da barra (Plot4) = VENDA
       → Delta está negativo (-10% ou menos)
       → Preço está próximo ao VWAP
       → Execute: Venda 1 contrato
       → Stop: +50 pontos
       → Target: -100 pontos

  4. AJUSTES:
     Para mudar sensibilidade, edite linhas 76-78:

     MAIS CONSERVADOR (menos sinais):
     VWAPDeviationPct := 0.05;
     DeltaThreshold := 20;

     MAIS AGRESSIVO (mais sinais):
     VWAPDeviationPct := 0.15;
     DeltaThreshold := 5;

  5. INTERPRETAÇÃO:
     - Preço TOCA o VWAP azul = Momento de atenção
     - Delta POSITIVO (>10%) = Pressão compradora
     - Delta NEGATIVO (<-10%) = Pressão vendedora
     - Plot4 aparece = Setup confirmado

  6. REGRAS:
     ✓ SEMPRE opere com stop loss
     ✓ Opere apenas 1 contrato por vez
     ✓ Máximo 5 trades por dia
     ✓ Se tomar 3 stops seguidos, pare
     ✓ Opere entre 9h e 17:15h
     ✓ Teste em simulação primeiro!

  7. EXEMPLO:
     Situação às 10:30h:
     - Preço: 5650
     - VWAP Diário (azul): 5648
     - Delta (amarelo): +15%
     - Plot4: Aparece ABAIXO da barra

     Ação: COMPRA 1 contrato
     Stop: 5600
     Target: 5750

  IMPORTANTE:
  - Este é um INDICADOR, não robô automático
  - VOCÊ opera manualmente
  - SEMPRE teste em simulação
  - Trading tem risco de perda
  - Não opere com dinheiro que não pode perder

*******************************************************************************}
