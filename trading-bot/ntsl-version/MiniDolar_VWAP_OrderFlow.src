{*******************************************************************************
  ROBÔ DE TRADING - MINI DÓLAR (WDO)

  Estratégia: VWAP + Order Flow
  Autor: Prof. Rodolfo Barriviera
  Versão: 1.2 NTSL (Corrigida para sintaxe de Automação)

  LÓGICA:
  - LONG: Preço próximo ao VWAP + Fluxo comprador
  - SHORT: Preço próximo ao VWAP + Fluxo vendedor
  - Saídas: Stop Loss, Take Profit ou reversão de fluxo

  IMPORTANTE: SEMPRE TESTE EM SIMULAÇÃO ANTES DE USAR EM CONTA REAL!
*******************************************************************************}

Var
  // ========== PARÂMETROS CONFIGURÁVEIS ==========

  StopLossPoints     : Integer;
  TakeProfitPoints   : Integer;
  MaxContracts       : Integer;
  VWAPDeviationPct   : Float;
  DeltaThreshold     : Float;
  FlowWindowSize     : Integer;

  EnableLongTrades   : Boolean;
  EnableShortTrades  : Boolean;
  EnableFlowExit     : Boolean;

  StartTime          : Integer;
  EndTime            : Integer;
  StopNewTradesTime  : Integer;

  // ========== VARIÁVEIS INTERNAS ==========

  // VWAP
  VWAPDaily          : Float;
  VWAPWeekly         : Float;
  DailyPV            : Float;
  DailyVolume        : Float;
  WeeklyPV           : Float;
  WeeklyVolume       : Float;

  // Controle de tempo
  LastDate           : Integer;
  LastWeek           : Integer;
  CurrentTime        : Integer;
  CurrentDay         : Integer;

  // Fluxo de Ordens
  BuyVolume          : Float;
  SellVolume         : Float;
  Delta              : Float;
  DeltaPct           : Float;

  // Arrays para janela deslizante
  FlowVolumes        : Array[0..200] of Float;
  FlowAggressors     : Array[0..200] of Integer;
  FlowIndex          : Integer;

  // Controle de Posição
  InPosition         : Boolean;
  PositionType       : Integer;
  EntryPrice         : Float;
  StopPrice          : Float;
  TargetPrice        : Float;

  // Sinais
  LongSignal         : Boolean;
  ShortSignal        : Boolean;
  ExitSignal         : Boolean;

  // Auxiliares
  PriceVsVWAP        : Float;
  IsInsideTime       : Boolean;
  CanEnterNew        : Boolean;
  PrevClose          : Float;

  // Contadores
  TradesCount        : Integer;
  i                  : Integer;
  Initialized        : Boolean;

Begin

  // ========== INICIALIZAÇÃO ==========

  If Not Initialized Then Begin
    // PERFIL MODERADO (PADRÃO)
    StopLossPoints         := 50;
    TakeProfitPoints       := 100;
    MaxContracts           := 1;
    VWAPDeviationPct       := 0.05;
    DeltaThreshold         := 20;
    FlowWindowSize         := 100;
    EnableLongTrades       := True;
    EnableShortTrades      := True;
    EnableFlowExit         := True;
    StartTime              := 900;
    EndTime                := 1730;
    StopNewTradesTime      := 1715;

    // PERFIL CONSERVADOR (descomente para usar)
    {
    StopLossPoints         := 40;
    TakeProfitPoints       := 80;
    DeltaThreshold         := 25;
    FlowWindowSize         := 150;
    }

    // PERFIL AGRESSIVO (descomente para usar)
    {
    StopLossPoints         := 70;
    TakeProfitPoints       := 140;
    MaxContracts           := 2;
    DeltaThreshold         := 15;
    FlowWindowSize         := 75;
    }

    Initialized := True;
  End;


  // ========== CONTROLE DE TEMPO ==========

  // Reset diário do VWAP
  If Date <> LastDate Then Begin
    DailyPV := 0;
    DailyVolume := 0;
    LastDate := Date;
  End;

  // Reset semanal do VWAP (segunda-feira = dia 2)
  CurrentDay := DayOfWeek(Date);
  If CurrentDay = 2 Then Begin
    If LastWeek <> Date Then Begin
      WeeklyPV := 0;
      WeeklyVolume := 0;
      LastWeek := Date;
    End;
  End;

  // Verifica horário de operação
  CurrentTime := Time;
  IsInsideTime := (CurrentTime >= StartTime) And (CurrentTime <= EndTime);
  CanEnterNew := (CurrentTime >= StartTime) And (CurrentTime <= StopNewTradesTime);


  // ========== CÁLCULO DO VWAP ==========

  DailyPV := DailyPV + (Close * Volume);
  DailyVolume := DailyVolume + Volume;

  If DailyVolume > 0 Then
    VWAPDaily := DailyPV / DailyVolume
  Else
    VWAPDaily := Close;

  WeeklyPV := WeeklyPV + (Close * Volume);
  WeeklyVolume := WeeklyVolume + Volume;

  If WeeklyVolume > 0 Then
    VWAPWeekly := WeeklyPV / WeeklyVolume
  Else
    VWAPWeekly := Close;


  // ========== ANÁLISE DE FLUXO (SIMPLIFICADA) ==========

  // Adiciona tick atual ao array
  FlowIndex := FlowIndex + 1;
  If FlowIndex > FlowWindowSize Then
    FlowIndex := 0;

  FlowVolumes[FlowIndex] := Volume;

  // Identifica agressor (simplificado - por variação de preço)
  If Close > PrevClose Then
    FlowAggressors[FlowIndex] := 1       // Compra
  Else If Close < PrevClose Then
    FlowAggressors[FlowIndex] := -1      // Venda
  Else
    FlowAggressors[FlowIndex] := 0;      // Neutro

  PrevClose := Close;

  // Calcula delta de volume
  BuyVolume := 0;
  SellVolume := 0;

  For i := 0 To FlowWindowSize Do Begin
    If FlowAggressors[i] = 1 Then
      BuyVolume := BuyVolume + FlowVolumes[i]
    Else If FlowAggressors[i] = -1 Then
      SellVolume := SellVolume + FlowVolumes[i];
  End;

  Delta := BuyVolume - SellVolume;

  If (BuyVolume + SellVolume) > 0 Then
    DeltaPct := (Delta / (BuyVolume + SellVolume)) * 100
  Else
    DeltaPct := 0;


  // ========== SINAIS DE ENTRADA ==========

  If VWAPDaily > 0 Then
    PriceVsVWAP := ((Close - VWAPDaily) / VWAPDaily) * 100
  Else
    PriceVsVWAP := 0;

  LongSignal := False;
  ShortSignal := False;


  // SINAL LONG
  If EnableLongTrades And CanEnterNew And (Not InPosition) Then Begin
    If (PriceVsVWAP >= -VWAPDeviationPct) And (PriceVsVWAP <= VWAPDeviationPct) Then Begin
      If DeltaPct > DeltaThreshold Then Begin
        If (VWAPWeekly = 0) Or (Close >= VWAPWeekly * 0.98) Then Begin
          LongSignal := True;
        End;
      End;
    End;
  End;


  // SINAL SHORT
  If EnableShortTrades And CanEnterNew And (Not InPosition) Then Begin
    If (PriceVsVWAP >= -VWAPDeviationPct) And (PriceVsVWAP <= VWAPDeviationPct) Then Begin
      If DeltaPct < -DeltaThreshold Then Begin
        If (VWAPWeekly = 0) Or (Close <= VWAPWeekly * 1.02) Then Begin
          ShortSignal := True;
        End;
      End;
    End;
  End;


  // ========== SAÍDAS ==========

  ExitSignal := False;

  If InPosition Then Begin

    If PositionType = 1 Then Begin  // Long
      If Close <= StopPrice Then
        ExitSignal := True;

      If Close >= TargetPrice Then
        ExitSignal := True;

      If EnableFlowExit And (DeltaPct < -DeltaThreshold) Then
        ExitSignal := True;
    End;

    If PositionType = -1 Then Begin  // Short
      If Close >= StopPrice Then
        ExitSignal := True;

      If Close <= TargetPrice Then
        ExitSignal := True;

      If EnableFlowExit And (DeltaPct > DeltaThreshold) Then
        ExitSignal := True;
    End;

    If CurrentTime >= EndTime Then
      ExitSignal := True;

  End;


  // ========== EXECUÇÃO DE ORDENS ==========

  // ENTRADA LONG
  If LongSignal Then Begin
    Compra(MaxContracts);
    InPosition := True;
    PositionType := 1;
    EntryPrice := Close;
    StopPrice := Close - StopLossPoints;
    TargetPrice := Close + TakeProfitPoints;
    TradesCount := TradesCount + 1;
  End;


  // ENTRADA SHORT
  If ShortSignal Then Begin
    Venda(MaxContracts);
    InPosition := True;
    PositionType := -1;
    EntryPrice := Close;
    StopPrice := Close + StopLossPoints;
    TargetPrice := Close - TakeProfitPoints;
    TradesCount := TradesCount + 1;
  End;


  // SAÍDA
  If ExitSignal Then Begin
    If PositionType = 1 Then
      Venda(MaxContracts)
    Else If PositionType = -1 Then
      Compra(MaxContracts);

    InPosition := False;
    PositionType := 0;
  End;


  // ========== INDICADORES NO GRÁFICO ==========

  // VWAP Diário (azul)
  Plot(VWAPDaily);

  // VWAP Semanal (verde)
  Plot2(VWAPWeekly);

  // Delta (para debug - remova se quiser)
  // Plot3(DeltaPct);

End;

{*******************************************************************************
  INSTRUÇÕES DE USO:

  1. Copie TODO este código
  2. Abra o Profit Pro
  3. Vá em "Automação" > "Editor de Estratégias"
  4. Cole este código
  5. Compile (F9)
  6. Aplique no gráfico do WDO
  7. Configure para conta de SIMULAÇÃO
  8. Habilite envio de ordens

  PERFIS:
  - MODERADO está ativo (linhas 102-115)
  - Para CONSERVADOR: descomente linhas 118-123
  - Para AGRESSIVO: descomente linhas 126-132

  O QUE APARECE NO GRÁFICO:
  - Plot (azul): VWAP Diário
  - Plot2 (verde): VWAP Semanal

  COMO FUNCIONA:
  - Compra quando preço está no VWAP e fluxo é comprador
  - Vende quando preço está no VWAP e fluxo é vendedor
  - Stop Loss e Take Profit automáticos
  - Sai por reversão de fluxo (opcional)

  IMPORTANTE:
  - Teste MUITO em simulação antes de usar real
  - Monitore constantemente
  - Comece com 1 contrato
  - Ajuste conforme necessário

*******************************************************************************}
