{*******************************************************************************
  ROBÔ DE TRADING - MINI DÓLAR (WDO)

  Estratégia: VWAP + Order Flow
  Autor: Prof. Rodolfo Barriviera
  Versão: 1.3 NTSL - SINAIS VISUAIS

  IMPORTANTE:
  Esta versão GERA SINAIS no gráfico (setas de compra/venda).
  Para executar automaticamente, configure o módulo de Automação do Profit
  para operar quando aparecer SetaCompra/SetaVenda.

  LÓGICA:
  - LONG: Preço próximo ao VWAP + Fluxo comprador
  - SHORT: Preço próximo ao VWAP + Fluxo vendedor
  - Gerenciamento de risco interno com stop/target

  SEMPRE TESTE EM SIMULAÇÃO PRIMEIRO!
*******************************************************************************}

Var
  // ========== PARÂMETROS CONFIGURÁVEIS ==========

  StopLossPoints     : Integer;
  TakeProfitPoints   : Integer;
  VWAPDeviationPct   : Float;
  DeltaThreshold     : Float;
  FlowWindowSize     : Integer;

  EnableLongTrades   : Boolean;
  EnableShortTrades  : Boolean;
  EnableFlowExit     : Boolean;

  StartTime          : Integer;
  EndTime            : Integer;
  StopNewTradesTime  : Integer;

  // ========== VARIÁVEIS INTERNAS ==========

  // VWAP
  VWAPDaily          : Float;
  VWAPWeekly         : Float;
  DailyPV            : Float;
  DailyVolume        : Float;
  WeeklyPV           : Float;
  WeeklyVolume       : Float;

  // Controle de tempo
  LastDate           : Integer;
  LastWeek           : Integer;
  CurrentTime        : Integer;
  CurrentDay         : Integer;

  // Fluxo de Ordens
  BuyVolume          : Float;
  SellVolume         : Float;
  Delta              : Float;
  DeltaPct           : Float;

  // Arrays para janela deslizante
  FlowVolumes        : Array[0..200] of Float;
  FlowAggressors     : Array[0..200] of Integer;
  FlowIndex          : Integer;

  // Controle de Posição (interno)
  InPosition         : Boolean;
  PositionType       : Integer;
  EntryPrice         : Float;
  StopPrice          : Float;
  TargetPrice        : Float;

  // Sinais
  LongSignal         : Boolean;
  ShortSignal        : Boolean;
  ExitSignal         : Boolean;

  // Auxiliares
  PriceVsVWAP        : Float;
  IsInsideTime       : Boolean;
  CanEnterNew        : Boolean;
  PrevClose          : Float;

  // Contadores
  i                  : Integer;
  Initialized        : Boolean;

Begin

  // ========== INICIALIZAÇÃO ==========

  If Not Initialized Then Begin
    // PERFIL MODERADO (PADRÃO)
    StopLossPoints         := 50;
    TakeProfitPoints       := 100;
    VWAPDeviationPct       := 0.05;
    DeltaThreshold         := 20;
    FlowWindowSize         := 100;
    EnableLongTrades       := True;
    EnableShortTrades      := True;
    EnableFlowExit         := True;
    StartTime              := 900;
    EndTime                := 1730;
    StopNewTradesTime      := 1715;

    // PERFIL CONSERVADOR (descomente para usar)
    {
    StopLossPoints         := 40;
    TakeProfitPoints       := 80;
    DeltaThreshold         := 25;
    FlowWindowSize         := 150;
    }

    // PERFIL AGRESSIVO (descomente para usar)
    {
    StopLossPoints         := 70;
    TakeProfitPoints       := 140;
    DeltaThreshold         := 15;
    FlowWindowSize         := 75;
    }

    Initialized := True;
  End;


  // ========== CONTROLE DE TEMPO ==========

  If Date <> LastDate Then Begin
    DailyPV := 0;
    DailyVolume := 0;
    LastDate := Date;
  End;

  CurrentDay := DayOfWeek(Date);
  If CurrentDay = 2 Then Begin
    If LastWeek <> Date Then Begin
      WeeklyPV := 0;
      WeeklyVolume := 0;
      LastWeek := Date;
    End;
  End;

  CurrentTime := Time;
  IsInsideTime := (CurrentTime >= StartTime) And (CurrentTime <= EndTime);
  CanEnterNew := (CurrentTime >= StartTime) And (CurrentTime <= StopNewTradesTime);


  // ========== CÁLCULO DO VWAP ==========

  DailyPV := DailyPV + (Close * Volume);
  DailyVolume := DailyVolume + Volume;

  If DailyVolume > 0 Then
    VWAPDaily := DailyPV / DailyVolume
  Else
    VWAPDaily := Close;

  WeeklyPV := WeeklyPV + (Close * Volume);
  WeeklyVolume := WeeklyVolume + Volume;

  If WeeklyVolume > 0 Then
    VWAPWeekly := WeeklyPV / WeeklyVolume
  Else
    VWAPWeekly := Close;


  // ========== ANÁLISE DE FLUXO ==========

  FlowIndex := FlowIndex + 1;
  If FlowIndex > FlowWindowSize Then
    FlowIndex := 0;

  FlowVolumes[FlowIndex] := Volume;

  If Close > PrevClose Then
    FlowAggressors[FlowIndex] := 1
  Else If Close < PrevClose Then
    FlowAggressors[FlowIndex] := -1
  Else
    FlowAggressors[FlowIndex] := 0;

  PrevClose := Close;

  BuyVolume := 0;
  SellVolume := 0;

  For i := 0 To FlowWindowSize Do Begin
    If FlowAggressors[i] = 1 Then
      BuyVolume := BuyVolume + FlowVolumes[i]
    Else If FlowAggressors[i] = -1 Then
      SellVolume := SellVolume + FlowVolumes[i];
  End;

  Delta := BuyVolume - SellVolume;

  If (BuyVolume + SellVolume) > 0 Then
    DeltaPct := (Delta / (BuyVolume + SellVolume)) * 100
  Else
    DeltaPct := 0;


  // ========== SINAIS DE ENTRADA ==========

  If VWAPDaily > 0 Then
    PriceVsVWAP := ((Close - VWAPDaily) / VWAPDaily) * 100
  Else
    PriceVsVWAP := 0;

  LongSignal := False;
  ShortSignal := False;


  // SINAL LONG
  If EnableLongTrades And CanEnterNew And (Not InPosition) Then Begin
    If (PriceVsVWAP >= -VWAPDeviationPct) And (PriceVsVWAP <= VWAPDeviationPct) Then Begin
      If DeltaPct > DeltaThreshold Then Begin
        If (VWAPWeekly = 0) Or (Close >= VWAPWeekly * 0.98) Then Begin
          LongSignal := True;
        End;
      End;
    End;
  End;


  // SINAL SHORT
  If EnableShortTrades And CanEnterNew And (Not InPosition) Then Begin
    If (PriceVsVWAP >= -VWAPDeviationPct) And (PriceVsVWAP <= VWAPDeviationPct) Then Begin
      If DeltaPct < -DeltaThreshold Then Begin
        If (VWAPWeekly = 0) Or (Close <= VWAPWeekly * 1.02) Then Begin
          ShortSignal := True;
        End;
      End;
    End;
  End;


  // ========== GERENCIAMENTO DE POSIÇÃO ==========

  ExitSignal := False;

  If InPosition Then Begin

    If PositionType = 1 Then Begin
      If Close <= StopPrice Then
        ExitSignal := True;

      If Close >= TargetPrice Then
        ExitSignal := True;

      If EnableFlowExit And (DeltaPct < -DeltaThreshold) Then
        ExitSignal := True;
    End;

    If PositionType = -1 Then Begin
      If Close >= StopPrice Then
        ExitSignal := True;

      If Close <= TargetPrice Then
        ExitSignal := True;

      If EnableFlowExit And (DeltaPct > DeltaThreshold) Then
        ExitSignal := True;
    End;

    If CurrentTime >= EndTime Then
      ExitSignal := True;

  End;


  // ========== GERAÇÃO DE SINAIS VISUAIS ==========

  // ENTRADA LONG
  If LongSignal Then Begin
    SetaCompra(Low - 10);  // Seta verde abaixo da barra
    InPosition := True;
    PositionType := 1;
    EntryPrice := Close;
    StopPrice := Close - StopLossPoints;
    TargetPrice := Close + TakeProfitPoints;
  End;


  // ENTRADA SHORT
  If ShortSignal Then Begin
    SetaVenda(High + 10);  // Seta vermelha acima da barra
    InPosition := True;
    PositionType := -1;
    EntryPrice := Close;
    StopPrice := Close + StopLossPoints;
    TargetPrice := Close - TakeProfitPoints;
  End;


  // SAÍDA
  If ExitSignal Then Begin
    If PositionType = 1 Then
      SetaVenda(High + 10)   // Fecha long
    Else If PositionType = -1 Then
      SetaCompra(Low - 10);  // Fecha short

    InPosition := False;
    PositionType := 0;
  End;


  // ========== PLOTAGEM NO GRÁFICO ==========

  // VWAP Diário (linha principal - azul)
  Plot(VWAPDaily);

  // VWAP Semanal (linha secundária - verde)
  Plot2(VWAPWeekly);

  // Delta % (linha terciária - amarela) - opcional
  Plot3(DeltaPct);

  // Linhas de referência do VWAP (±0.5%)
  Plot4(VWAPDaily * 1.005);  // Banda superior
  Plot5(VWAPDaily * 0.995);  // Banda inferior

End;

{*******************************************************************************
  INSTRUÇÕES DE USO:

  1. INSTALAÇÃO:
     - Copie TODO este código
     - Abra Profit Pro
     - Automação > Editor de Estratégias
     - Cole e compile (F9)
     - Aplique no gráfico do WDO

  2. O QUE APARECE NO GRÁFICO:
     - Plot (azul): VWAP Diário
     - Plot2 (verde): VWAP Semanal
     - Plot3 (amarelo): Delta %
     - Plot4/5 (cinza): Bandas ±0.5%
     - SetaCompra (verde): Sinal de compra
     - SetaVenda (vermelho): Sinal de venda

  3. COMO OPERAR:

     OPÇÃO A - MANUAL:
     - Quando aparecer SetaCompra (verde) → Compre manualmente
     - Quando aparecer SetaVenda (vermelho) → Venda manualmente
     - Use stop de 50 pontos e target de 100 pontos

     OPÇÃO B - AUTOMÁTICO (Módulo de Automação):
     - Configure o módulo de Automação do Profit
     - Ação: "Comprar quando SetaCompra"
     - Ação: "Vender quando SetaVenda"
     - Quantidade: 1 contrato

  4. PERFIS:
     - MODERADO: linhas 100-112 (ATIVO)
     - CONSERVADOR: linhas 115-120 (descomente)
     - AGRESSIVO: linhas 123-128 (descomente)

  5. AJUSTES RÁPIDOS:
     Para mudar apenas stop/target, edite linhas 101-102:
     StopLossPoints := 50;    (mude aqui)
     TakeProfitPoints := 100; (mude aqui)

  6. IMPORTANTE:
     - SEMPRE teste em simulação primeiro
     - Monitore constantemente as primeiras operações
     - Ajuste os parâmetros conforme seu estilo
     - Respeite sempre o stop loss

  7. COMO FUNCIONA:
     - Identifica quando preço está no VWAP
     - Analisa se fluxo é comprador ou vendedor
     - Gera sinal visual (seta)
     - Você executa manualmente OU Profit executa automaticamente

*******************************************************************************}
